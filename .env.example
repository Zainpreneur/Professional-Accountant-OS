# SQLite database used by Prisma (packages/db) and the API.
# Relative SQLite paths resolve against packages/db/prisma/, so this creates
# packages/db/prisma/dev.db - no database server or Docker required.
DATABASE_URL="file:./dev.db"

# JWT signing secret for the API - change in production
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# API server port
API_PORT=4000

# Web app -> API base URL (Vite reads VITE_* variables at build/dev time)
VITE_API_URL="http://localhost:4000"
