# Postgres connection used by Prisma (packages/db) and the API
DATABASE_URL="postgresql://accountant_os:accountant_os@localhost:5432/accountant_os?schema=public"

# JWT signing secret for the API - change in production
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# API server port
API_PORT=4000

# Web app -> API base URL
NEXT_PUBLIC_API_URL="http://localhost:4000"
