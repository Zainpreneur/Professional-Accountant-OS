// Professional Accountant OS - Phase 1 data model
// Covers: multi-tenancy, RBAC, client onboarding, chart of accounts,
// general ledger (double-entry), AR/AP (invoices/bills), payments,
// documents, and audit trail. See docs/SRS.md for the full target scope
// and docs/ARCHITECTURE.md for what is implemented vs. planned.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity, firm, tenancy (SRS 3, 5, 53-55)
// ---------------------------------------------------------------------------

model Firm {
  id        String   @id @default(uuid())
  name      String
  legalName String?
  country   String   @default("SA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  clients   Client[]
  roles     Role[]
  documents Document[]
  auditLogs AuditLog[]

  @@map("firms")
}


model User {
  id           String     @id @default(uuid())
  firmId       String
  firm         Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  firstName    String
  lastName     String
  status       String @default("INVITED")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  userRoles            UserRole[]
  createdJournals      Journal[]             @relation("JournalCreatedBy")
  postedJournals       Journal[]             @relation("JournalPostedBy")
  documents            Document[]
  auditLogs            AuditLog[]
  clientMembers        ClientMember[]
  bankStatementImports BankStatementImport[]

  engagementsCreated         Engagement[]               @relation("EngagementCreatedBy")
  engagementsConcluded       Engagement[]               @relation("EngagementConcludedBy")
  engagementsApproved        Engagement[]               @relation("EngagementApprovedBy")
  engagementTeamMemberships  EngagementTeamMember[]     @relation("EngagementTeamMembership")
  independenceChecksLogged   IndependenceCheck[]        @relation("IndependenceCheckedBy")
  independenceChecksResolved IndependenceCheck[]        @relation("IndependenceResolvedBy")
  auditRisksCreated          AuditRisk[]                @relation("AuditRiskCreatedBy")
  proceduresPerformed        AuditProcedure[]           @relation("ProcedurePerformedBy")
  evidenceObtained           AuditEvidence[]            @relation("EvidenceObtainedBy")
  findingsCreated            AuditFinding[]             @relation("FindingCreatedBy")
  completionItemsCompleted   EngagementCompletionItem[] @relation("CompletionItemCompletedBy")
  judgmentCasesCreated       ProfessionalJudgmentCase[] @relation("JudgmentCreatedBy")
  judgmentCasesDecided       ProfessionalJudgmentCase[] @relation("JudgmentDecidedBy")
  judgmentCasesApproved      ProfessionalJudgmentCase[] @relation("JudgmentApprovedBy")
  aiAgentRunsReviewed        AiAgentRun[]               @relation("AiAgentRunReviewedBy")

  @@unique([firmId, email])
  @@map("users")
}

// A Role bundles a set of permission codes (see apps/api/src/rbac/permissions.ts
// for the canonical list, mirroring SRS 54). A Role with firmId = null is a
// system-defined role available to every firm; a firm can also define custom
// roles.
model Role {
  id          String   @id @default(uuid())
  firmId      String?
  firm        Firm?    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions String
  createdAt   DateTime @default(now())

  userRoles UserRole[]

  @@unique([firmId, name])
  @@map("roles")
}

// Assigns a Role to a User, optionally scoped to a single Client (e.g. a
// client-portal user only has CLIENT_ADMIN on their own client). A null
// clientId means the role applies firm-wide.
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId, clientId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Clients & engagements (SRS 6, 77)
// ---------------------------------------------------------------------------


model Client {
  id                    String       @id @default(uuid())
  firmId                String
  firm                  Firm         @relation(fields: [firmId], references: [id], onDelete: Cascade)
  legalName             String
  tradingName           String?
  entityType            String?
  businessCategory      String?
  jurisdiction          String       @default("SA")
  taxRegistrationNumber String?
  baseCurrency          String       @default("SAR")
  status                String @default("ONBOARDING")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  engagements          Engagement[]
  accounts             ChartOfAccount[]
  fiscalYears          FiscalYear[]
  accountingPeriods    AccountingPeriod[]
  journals             Journal[]
  customers            Customer[]
  suppliers            Supplier[]
  invoices             Invoice[]
  bills                Bill[]
  payments             Payment[]
  documents            Document[]
  auditLogs            AuditLog[]
  userRoles            UserRole[]
  members              ClientMember[]
  employees            Employee[]
  fixedAssets          FixedAsset[]
  depreciationRuns     DepreciationRun[]
  products             Product[]
  warehouses           Warehouse[]
  stockMovements       StockMovement[]
  expenseClaims        ExpenseClaim[]
  payrollRuns          PayrollRun[]
  bankStatementImports BankStatementImport[]
  bankReconciliations  BankReconciliation[]
  taxPeriods           TaxPeriod[]
  vatReturns           VatReturn[]
  whtReturns           WhtReturn[]
  zakatReturns         ZakatReturn[]
  complianceDeadlines  ComplianceDeadline[]
  judgmentCases        ProfessionalJudgmentCase[]
  aiAgentRuns          AiAgentRun[]

  @@unique([firmId, legalName])
  @@map("clients")
}

// A client-portal user's membership in a client (distinct from firm staff).
// Mirrors SRS 3.6/3.7 (Client Administrator / Client Employee).
model ClientMember {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())

  @@unique([clientId, userId])
  @@map("client_members")
}




// Professional CA (SRS 33, 77). Acceptance/continuance, materiality, and
// team are set up before fieldwork; conclusion + partner approval close it
// out. `concludedById`/`approvedById` are deliberately separate users -
// EngagementsService.approve() rejects an approver who matches the
// concluder, enforcing SRS 55 segregation of duties by identity, not just
// by permission (a firm could otherwise grant one person both permissions).
model Engagement {
  id          String           @id @default(uuid())
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceType String
  periodStart DateTime
  periodEnd   DateTime
  status      String @default("PLANNED")

  acceptanceStatus   String    @default("PENDING")
  materialityAmount  Decimal?
  materialityBasis   String?
  scope              String?
  independenceStatus String?

  createdById String
  createdBy   User   @relation("EngagementCreatedBy", fields: [createdById], references: [id])

  conclusionText String?
  concludedById  String?
  concludedBy    User?     @relation("EngagementConcludedBy", fields: [concludedById], references: [id])
  concludedAt    DateTime?
  approvedById   String?
  approvedBy     User?     @relation("EngagementApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamMembers        EngagementTeamMember[]
  independenceChecks IndependenceCheck[]
  risks              AuditRisk[]
  procedures         AuditProcedure[]
  evidence           AuditEvidence[]
  findings           AuditFinding[]
  completionItems    EngagementCompletionItem[]
  judgmentCases      ProfessionalJudgmentCase[]

  @@map("engagements")
}


model EngagementTeamMember {
  id           String             @id @default(uuid())
  engagementId String
  engagement   Engagement         @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  userId       String
  user         User               @relation("EngagementTeamMembership", fields: [userId], references: [id])
  role         String
  createdAt    DateTime           @default(now())

  @@unique([engagementId, userId])
  @@map("engagement_team_members")
}


// Independence Engine (SRS 36). Any threat flag true => status EXCEPTION,
// which must be resolved before... - this app doesn't hard-block other
// engagement actions on an open exception (that's a firm policy decision),
// but it does enforce that whoever resolves an exception is not the same
// user who logged it (SRS 55-style segregation), and every exception is
// visible on the engagement record via `independenceStatus`.
model IndependenceCheck {
  id           String     @id @default(uuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  hasFinancialInterest          Boolean            @default(false)
  hasCloseRelationship          Boolean            @default(false)
  hasPriorEngagementConflict    Boolean            @default(false)
  hasProhibitedActivity         Boolean            @default(false)
  selfReviewThreat              Boolean            @default(false)
  familiarityThreat             Boolean            @default(false)
  advocacyThreat                Boolean            @default(false)
  managementParticipationThreat Boolean            @default(false)
  notes                         String?
  status                        String

  checkedById String
  checkedBy   User   @relation("IndependenceCheckedBy", fields: [checkedById], references: [id])

  resolution      String @default("PENDING")
  resolutionNotes String?
  resolvedById    String?
  resolvedBy      User?                  @relation("IndependenceResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?

  createdAt DateTime @default(now())

  @@map("independence_checks")
}



// SRS 34 assertions, used to tag both risks and the procedures that
// address them, and findings that relate to either.

model AuditRisk {
  id            String            @id @default(uuid())
  engagementId  String
  engagement    Engagement        @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  description   String
  category      String
  assertion     String?
  likelihood    String
  impact        String
  isSignificant Boolean           @default(false)
  response      String?

  createdById String
  createdBy   User     @relation("AuditRiskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  procedures AuditProcedure[]
  findings   AuditFinding[]

  @@map("audit_risks")
}



model AuditProcedure {
  id            String               @id @default(uuid())
  engagementId  String
  engagement    Engagement           @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  riskId        String?
  risk          AuditRisk?           @relation(fields: [riskId], references: [id])
  assertion     String
  procedureType String
  description   String
  sampleSize    Int?
  status        String @default("NOT_STARTED")

  performedById String?
  performedBy   User?     @relation("ProcedurePerformedBy", fields: [performedById], references: [id])
  performedAt   DateTime?
  conclusion    String?

  createdAt DateTime @default(now())

  evidence AuditEvidence[]
  findings AuditFinding[]

  @@map("audit_procedures")
}


// Evidence chain (SRS 33, 41): links a piece of evidence (a Document when
// there's a file, or just a description for an oral confirmation/
// observation) to the procedure or finding it supports.
model AuditEvidence {
  id           String            @id @default(uuid())
  engagementId String
  engagement   Engagement        @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  procedureId  String?
  procedure    AuditProcedure?   @relation(fields: [procedureId], references: [id])
  findingId    String?
  finding      AuditFinding?     @relation(fields: [findingId], references: [id])
  documentId   String?
  document     Document?         @relation(fields: [documentId], references: [id])
  description  String
  evidenceType String

  obtainedById String
  obtainedBy   User     @relation("EvidenceObtainedBy", fields: [obtainedById], references: [id])
  obtainedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@map("audit_evidence")
}




model AuditFinding {
  id                 String               @id @default(uuid())
  engagementId       String
  engagement         Engagement           @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  procedureId        String?
  procedure          AuditProcedure?      @relation(fields: [procedureId], references: [id])
  riskId             String?
  risk               AuditRisk?           @relation(fields: [riskId], references: [id])
  type               String
  assertion          String?
  description        String
  amount             Decimal?
  severity           String
  recommendation     String?
  managementResponse String?
  status             String   @default("OPEN")

  createdById String
  createdBy   User      @relation("FindingCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  evidence AuditEvidence[]

  @@map("audit_findings")
}


// Completion checklist (SRS 33). EngagementsService seeds a standard set of
// items (subsequent events, going concern, management representation
// letter, ...) when completion starts - see STANDARD_COMPLETION_CHECKLIST.
model EngagementCompletionItem {
  id            String               @id @default(uuid())
  engagementId  String
  engagement    Engagement           @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  item          String
  status        String @default("PENDING")
  completedById String?
  completedBy   User?                @relation("CompletionItemCompletedBy", fields: [completedById], references: [id])
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime             @default(now())

  @@unique([engagementId, item])
  @@map("engagement_completion_items")
}



// Professional Judgment Engine (SRS 35): Question -> Facts -> Applicable
// standards -> Possible treatments -> Professional decision -> Approval.
// Deliberately does NOT auto-generate "AI analysis" or "AI recommendation"
// text - there is no LLM wired into this app process, and fabricating
// plausible-sounding professional reasoning would be actively misleading
// rather than a defensible heuristic (unlike e.g. Phase 2's classification
// suggester). `recommendation`/`decision` are filled by the professional
// (or, later, a real model call slotted into ProfessionalJudgmentService).
// `decidedById` and `approvedById` are enforced distinct, same as
// Engagement conclusion/approval.
model ProfessionalJudgmentCase {
  id                  String         @id @default(uuid())
  clientId            String
  client              Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  engagementId        String?
  engagement          Engagement?    @relation(fields: [engagementId], references: [id])
  question            String
  facts               String
  applicableStandards String?
  possibleTreatments  String?
  recommendation      String?
  risk                String   @default("MEDIUM")
  status              String @default("OPEN")

  decision    String?
  decidedById String?
  decidedBy   User?     @relation("JudgmentDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  approvedById String?
  approvedBy   User?     @relation("JudgmentApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdById String
  createdBy   User     @relation("JudgmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("professional_judgment_cases")
}

// ---------------------------------------------------------------------------
// Accounting core: chart of accounts, fiscal calendar (SRS 11-13)
// ---------------------------------------------------------------------------




model ChartOfAccount {
  id                     String              @id @default(uuid())
  clientId               String
  client                 Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code                   String
  name                   String
  type                   String
  subtype                String?
  parentId               String?
  parent                 ChartOfAccount?     @relation("AccountHierarchy", fields: [parentId], references: [id])
  children               ChartOfAccount[]    @relation("AccountHierarchy")
  normalBalance          String
  currency               String              @default("SAR")
  isControlAccount       Boolean             @default(false)
  controlAccountType     String?
  reconciliationRequired Boolean             @default(false)
  active                 Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  journalLines                  JournalLine[]
  customersAr                   Customer[]            @relation("CustomerArAccount")
  suppliersAp                   Supplier[]            @relation("SupplierApAccount")
  invoiceLines                  InvoiceLine[]
  billLines                     BillLine[]
  payments                      Payment[]
  assetsAsAssetAccount          FixedAsset[]          @relation("AssetAssetAccount")
  assetsAsDepreciationExpense   FixedAsset[]          @relation("AssetDepreciationExpenseAccount")
  assetsAsAccumulatedDep        FixedAsset[]          @relation("AssetAccumulatedDepreciationAccount")
  productsAsInventoryAccount    Product[]             @relation("ProductInventoryAccount")
  productsAsCogsAccount         Product[]             @relation("ProductCogsAccount")
  expenseClaimLines             ExpenseClaimLine[]
  expenseClaimsAsPaymentAccount ExpenseClaim[]        @relation("ExpenseClaimPaymentAccount")
  bankStatementImports          BankStatementImport[]
  bankReconciliations           BankReconciliation[]
  paymentsAsWhtPayableAccount   Payment[]             @relation("PaymentWhtPayableAccount")
  vatReturnsAsPayableAccount    VatReturn[]           @relation("VatReturnPayableAccount")
  zakatReturnsAsExpenseAccount  ZakatReturn[]         @relation("ZakatReturnExpenseAccount")
  zakatReturnsAsPayableAccount  ZakatReturn[]         @relation("ZakatReturnPayableAccount")

  @@unique([clientId, code])
  @@map("chart_of_accounts")
}


model FiscalYear {
  id        String       @id @default(uuid())
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  status    String @default("OPEN")

  periods AccountingPeriod[]

  @@unique([clientId, name])
  @@map("fiscal_years")
}

model AccountingPeriod {
  id           String       @id @default(uuid())
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fiscalYearId String
  fiscalYear   FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  name         String
  startDate    DateTime
  endDate      DateTime
  status       String @default("OPEN")

  journals Journal[]

  @@unique([clientId, name])
  @@map("accounting_periods")
}

// ---------------------------------------------------------------------------
// General ledger: journals & lines (SRS 11, 13, 65)
// ---------------------------------------------------------------------------



model Journal {
  id            String           @id @default(uuid())
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  journalNumber String
  date          DateTime
  periodId      String
  period        AccountingPeriod @relation(fields: [periodId], references: [id])
  source        String    @default("MANUAL")
  sourceType    String?
  sourceId      String?
  description   String?
  status        String    @default("DRAFT")

  createdById String
  createdBy   User      @relation("JournalCreatedBy", fields: [createdById], references: [id])
  postedById  String?
  postedBy    User?     @relation("JournalPostedBy", fields: [postedById], references: [id])
  postedAt    DateTime?

  reversalOfId String?
  reversalOf   Journal?  @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy   Journal[] @relation("JournalReversal")

  createdAt DateTime @default(now())

  lines                 JournalLine[]
  invoice               Invoice?
  bill                  Bill?
  payment               Payment?
  fixedAssetAcquisition FixedAsset?      @relation("FixedAssetAcquisitionJournal")
  fixedAssetDisposal    FixedAsset?      @relation("FixedAssetDisposalJournal")
  depreciationRun       DepreciationRun?
  stockMovement         StockMovement?
  expenseClaim          ExpenseClaim?
  payrollRun            PayrollRun?
  vatReturn             VatReturn?
  zakatReturn           ZakatReturn?

  @@unique([clientId, journalNumber])
  @@map("journals")
}

model JournalLine {
  id                String             @id @default(uuid())
  journalId         String
  journal           Journal            @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId         String
  account           ChartOfAccount     @relation(fields: [accountId], references: [id])
  debit             Decimal            @default(0)
  credit            Decimal            @default(0)
  description       String?
  lineNumber        Int
  // Bank reconciliation (SRS 16, 42): set once this line has been matched
  // to a bank statement line, so unmatched queues can filter cheaply.
  reconciled        Boolean            @default(false)
  bankStatementLine BankStatementLine?

  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Commercial master data (SRS 14-15)
// ---------------------------------------------------------------------------

model Customer {
  id          String          @id @default(uuid())
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code        String
  name        String
  email       String?
  phone       String?
  taxNumber   String?
  creditLimit Decimal?
  arAccountId String?
  arAccount   ChartOfAccount? @relation("CustomerArAccount", fields: [arAccountId], references: [id])
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())

  invoices Invoice[]
  payments Payment[]

  @@unique([clientId, code])
  @@map("customers")
}

model Supplier {
  id              String          @id @default(uuid())
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code            String
  name            String
  email           String?
  phone           String?
  taxNumber       String?
  apAccountId     String?
  apAccount       ChartOfAccount? @relation("SupplierApAccount", fields: [apAccountId], references: [id])
  // References RegulatoryRule.code for ruleType=WHT (SRS 28) - the default
  // withholding category applied to payments to this supplier. Nullable:
  // most suppliers (e.g. resident suppliers of goods) have no withholding.
  whtCategoryCode String?
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())

  bills    Bill[]
  payments Payment[]

  @@unique([clientId, code])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Sales / AR (SRS 14, 18)
// ---------------------------------------------------------------------------


model Invoice {
  id            String        @id @default(uuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  invoiceNumber String
  date          DateTime
  dueDate       DateTime
  currency      String        @default("SAR")
  status        String @default("DRAFT")
  subtotal      Decimal       @default(0)
  taxTotal      Decimal       @default(0)
  total         Decimal       @default(0)
  amountPaid    Decimal       @default(0)
  notes         String?
  journalId     String?       @unique
  journal       Journal?      @relation(fields: [journalId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines       InvoiceLine[]
  allocations PaymentAllocation[]
  einvoice    EInvoiceRecord?

  @@unique([clientId, invoiceNumber])
  @@map("invoices")
}

model InvoiceLine {
  id               String         @id @default(uuid())
  invoiceId        String
  invoice          Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description      String
  quantity         Decimal        @default(1)
  unitPrice        Decimal
  taxRate          Decimal        @default(0)
  lineTotal        Decimal
  revenueAccountId String
  revenueAccount   ChartOfAccount @relation(fields: [revenueAccountId], references: [id])
  lineNumber       Int

  @@map("invoice_lines")
}

// ---------------------------------------------------------------------------
// Purchases / AP (SRS 15, 19)
// ---------------------------------------------------------------------------


model Bill {
  id         String     @id @default(uuid())
  clientId   String
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier   @relation(fields: [supplierId], references: [id])
  billNumber String
  date       DateTime
  dueDate    DateTime
  currency   String     @default("SAR")
  status     String @default("DRAFT")
  subtotal   Decimal    @default(0)
  taxTotal   Decimal    @default(0)
  total      Decimal    @default(0)
  amountPaid Decimal    @default(0)
  notes      String?
  journalId  String?    @unique
  journal    Journal?   @relation(fields: [journalId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  lines       BillLine[]
  allocations PaymentAllocation[]

  @@unique([clientId, billNumber])
  @@map("bills")
}

model BillLine {
  id               String         @id @default(uuid())
  billId           String
  bill             Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  description      String
  quantity         Decimal        @default(1)
  unitPrice        Decimal
  taxRate          Decimal        @default(0)
  lineTotal        Decimal
  expenseAccountId String
  expenseAccount   ChartOfAccount @relation(fields: [expenseAccountId], references: [id])
  lineNumber       Int

  @@map("bill_lines")
}

// ---------------------------------------------------------------------------
// Payments (SRS 14-17)
// ---------------------------------------------------------------------------


model Payment {
  id            String         @id @default(uuid())
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type          String
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  supplierId    String?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  date          DateTime
  amount        Decimal
  bankAccountId String
  bankAccount   ChartOfAccount @relation(fields: [bankAccountId], references: [id])
  method        String?
  reference     String?
  journalId     String?        @unique
  journal       Journal?       @relation(fields: [journalId], references: [id])
  createdAt     DateTime       @default(now())

  // Withholding tax (SRS 28): when paying a supplier with a WHT category,
  // the amount actually wired to the bank is net of whtAmount, and
  // whtAmount is credited to whtPayableAccountId instead - see
  // PaymentsService and WhtReturnService, which aggregates these by period.
  // whtCategoryCode snapshots the supplier's category at payment time, so a
  // later change to the supplier's category never rewrites history.
  whtAmount           Decimal         @default(0)
  whtCategoryCode     String?
  whtPayableAccountId String?
  whtPayableAccount   ChartOfAccount? @relation("PaymentWhtPayableAccount", fields: [whtPayableAccountId], references: [id])

  allocations PaymentAllocation[]

  @@map("payments")
}

model PaymentAllocation {
  id        String   @id @default(uuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  billId    String?
  bill      Bill?    @relation(fields: [billId], references: [id])
  amount    Decimal

  @@map("payment_allocations")
}

// ---------------------------------------------------------------------------
// Documents (SRS 40-41)
// ---------------------------------------------------------------------------

model Document {
  id                String   @id @default(uuid())
  firmId            String
  firm              Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedById      String
  uploadedBy        User     @relation(fields: [uploadedById], references: [id])
  fileName          String
  mimeType          String
  sizeBytes         Int
  storageKey        String
  category          String?
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime @default(now())

  extraction    DocumentExtraction?
  auditEvidence AuditEvidence[]

  @@map("documents")
}

// ---------------------------------------------------------------------------
// Audit trail (SRS 56)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  firmId     String
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  before     String?
  after      String?
  createdAt  DateTime @default(now())

  @@index([firmId, entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2 - Accounting automation (docs/ARCHITECTURE.md roadmap)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// HR master data (shared by Expense Management and Payroll)
// ---------------------------------------------------------------------------


model Employee {
  id              String         @id @default(uuid())
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employeeCode    String
  firstName       String
  lastName        String
  email           String?
  jobTitle        String?
  hireDate        DateTime
  terminationDate DateTime?
  baseSalary      Decimal        @default(0)
  status          String @default("ACTIVE")
  createdAt       DateTime       @default(now())

  expenseClaims ExpenseClaim[]
  payslips      Payslip[]

  @@unique([clientId, employeeCode])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Fixed Assets (SRS 21)
// ---------------------------------------------------------------------------



// Depreciation and disposal are computed/posted by FixedAssetsService, never
// edited by hand - `accumulatedDepreciation` is a running total maintained
// exclusively by posted DepreciationRun / disposal journals (SRS 65: no
// destructive edits to what the ledger already says happened).
model FixedAsset {
  id                      String             @id @default(uuid())
  clientId                String
  client                  Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assetCode               String
  name                    String
  category                String?
  acquisitionDate         DateTime
  acquisitionCost         Decimal
  salvageValue            Decimal            @default(0)
  usefulLifeMonths        Int
  depreciationMethod      String @default("STRAIGHT_LINE")
  accumulatedDepreciation Decimal            @default(0)
  status                  String        @default("ACTIVE")

  assetAccountId                   String
  assetAccount                     ChartOfAccount @relation("AssetAssetAccount", fields: [assetAccountId], references: [id])
  depreciationExpenseAccountId     String
  depreciationExpenseAccount       ChartOfAccount @relation("AssetDepreciationExpenseAccount", fields: [depreciationExpenseAccountId], references: [id])
  accumulatedDepreciationAccountId String
  accumulatedDepreciationAccount   ChartOfAccount @relation("AssetAccumulatedDepreciationAccount", fields: [accumulatedDepreciationAccountId], references: [id])

  acquisitionJournalId String?  @unique
  acquisitionJournal   Journal? @relation("FixedAssetAcquisitionJournal", fields: [acquisitionJournalId], references: [id])

  disposalDate      DateTime?
  disposalProceeds  Decimal?
  disposalJournalId String?   @unique
  disposalJournal   Journal?  @relation("FixedAssetDisposalJournal", fields: [disposalJournalId], references: [id])

  createdAt DateTime @default(now())

  depreciationEntries DepreciationEntry[]

  @@unique([clientId, assetCode])
  @@map("fixed_assets")
}


// One run covers every ACTIVE asset for a client for one period, posting a
// single journal (SRS 21, 70): Debit each asset's depreciation expense
// account, Credit its accumulated depreciation account.
model DepreciationRun {
  id          String                @id @default(uuid())
  clientId    String
  client      Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodLabel String
  runDate     DateTime
  status      String @default("DRAFT")
  totalAmount Decimal               @default(0)
  journalId   String?               @unique
  journal     Journal?              @relation(fields: [journalId], references: [id])
  createdAt   DateTime              @default(now())

  entries DepreciationEntry[]

  @@unique([clientId, periodLabel])
  @@map("depreciation_runs")
}

model DepreciationEntry {
  id      String          @id @default(uuid())
  runId   String
  run     DepreciationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  assetId String
  asset   FixedAsset      @relation(fields: [assetId], references: [id])
  amount  Decimal

  @@unique([runId, assetId])
  @@map("depreciation_entries")
}

// ---------------------------------------------------------------------------
// Inventory (SRS 20)
// ---------------------------------------------------------------------------

model Product {
  id                 String         @id @default(uuid())
  clientId           String
  client             Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sku                String
  name               String
  unitOfMeasure      String         @default("unit")
  inventoryAccountId String
  inventoryAccount   ChartOfAccount @relation("ProductInventoryAccount", fields: [inventoryAccountId], references: [id])
  cogsAccountId      String
  cogsAccount        ChartOfAccount @relation("ProductCogsAccount", fields: [cogsAccountId], references: [id])
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now())

  stockLevels ProductStock[]
  movements   StockMovement[]

  @@unique([clientId, sku])
  @@map("products")
}

model Warehouse {
  id       String  @id @default(uuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code     String
  name     String
  active   Boolean @default(true)

  stockLevels ProductStock[]
  movements   StockMovement[]

  @@unique([clientId, code])
  @@map("warehouses")
}

// Running quantity/weighted-average-cost per product per warehouse,
// maintained exclusively by StockMovementsService as each movement posts.
model ProductStock {
  id             String    @id @default(uuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantityOnHand Decimal   @default(0)
  averageCost    Decimal   @default(0)

  @@unique([productId, warehouseId])
  @@map("product_stock")
}


// Every movement posts its own journal (SRS 20, 74): a RECEIPT debits
// inventory (using its own unit cost, which updates the weighted average);
// an ISSUE credits inventory and debits COGS at the current weighted
// average; an ADJUSTMENT moves inventory to/from a suspense-style
// adjustment account so shrinkage/found-stock is always traceable.
model StockMovement {
  id          String            @id @default(uuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  type        String
  date        DateTime
  quantity    Decimal
  unitCost    Decimal
  totalCost   Decimal
  reference   String?
  journalId   String?           @unique
  journal     Journal?          @relation(fields: [journalId], references: [id])
  createdAt   DateTime          @default(now())

  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Expense Management (SRS 23)
// ---------------------------------------------------------------------------


// A claim is reimbursed directly on posting (Debit each line's category
// account, Credit the chosen bank/cash account) - there is no employee
// payable subledger yet (see docs/ARCHITECTURE.md Phase 2 simplifications).
model ExpenseClaim {
  id               String             @id @default(uuid())
  clientId         String
  client           Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee           @relation(fields: [employeeId], references: [id])
  claimNumber      String
  date             DateTime
  status           String @default("DRAFT")
  totalAmount      Decimal            @default(0)
  paymentAccountId String?
  paymentAccount   ChartOfAccount?    @relation("ExpenseClaimPaymentAccount", fields: [paymentAccountId], references: [id])
  journalId        String?            @unique
  journal          Journal?           @relation(fields: [journalId], references: [id])
  createdAt        DateTime           @default(now())

  lines ExpenseClaimLine[]

  @@unique([clientId, claimNumber])
  @@map("expense_claims")
}

model ExpenseClaimLine {
  id                String         @id @default(uuid())
  claimId           String
  claim             ExpenseClaim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  description       String
  date              DateTime
  amount            Decimal
  categoryAccountId String
  categoryAccount   ChartOfAccount @relation(fields: [categoryAccountId], references: [id])
  lineNumber        Int

  @@map("expense_claim_lines")
}

// ---------------------------------------------------------------------------
// Payroll (SRS 22)
// ---------------------------------------------------------------------------


// Posts one journal per run (SRS 22, 70): Debit Salaries & Wages expense
// for total gross pay, Credit Salaries Payable for total net pay, Credit a
// deductions liability account for the difference (withheld amounts owed
// elsewhere - e.g. GOSI/WHT - are out of scope until Phase 3's regulatory
// rules engine assigns them real accounts).
model PayrollRun {
  id              String           @id @default(uuid())
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodLabel     String
  payDate         DateTime
  status          String @default("DRAFT")
  totalGross      Decimal          @default(0)
  totalDeductions Decimal          @default(0)
  totalNet        Decimal          @default(0)
  journalId       String?          @unique
  journal         Journal?         @relation(fields: [journalId], references: [id])
  createdAt       DateTime         @default(now())

  payslips Payslip[]

  @@unique([clientId, periodLabel])
  @@map("payroll_runs")
}

model Payslip {
  id           String     @id @default(uuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  basicSalary  Decimal
  allowances   Decimal    @default(0)
  deductions   Decimal    @default(0)
  grossPay     Decimal
  netPay       Decimal

  @@unique([payrollRunId, employeeId])
  @@map("payslips")
}

// ---------------------------------------------------------------------------
// Bank Reconciliation (SRS 16, 42)
// ---------------------------------------------------------------------------

model BankStatementImport {
  id            String         @id @default(uuid())
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bankAccountId String
  bankAccount   ChartOfAccount @relation(fields: [bankAccountId], references: [id])
  fileName      String
  importedById  String
  importedBy    User           @relation(fields: [importedById], references: [id])
  importedAt    DateTime       @default(now())

  lines BankStatementLine[]

  @@map("bank_statement_imports")
}


model BankStatementLine {
  id          String                  @id @default(uuid())
  importId    String
  import      BankStatementImport     @relation(fields: [importId], references: [id], onDelete: Cascade)
  date        DateTime
  description String
  // Signed: positive = money in (deposit), negative = money out (withdrawal).
  amount      Decimal
  reference   String?
  status      String @default("UNMATCHED")

  matchedJournalLineId String?      @unique
  matchedJournalLine   JournalLine? @relation(fields: [matchedJournalLineId], references: [id])

  @@map("bank_statement_lines")
}


// A reconciliation session snapshots the statement's ending balance so the
// UI can show book-vs-statement variance as matching progresses; completing
// one is a checkpoint, not a period lock (accounting periods already cover
// that - SRS 65).
model BankReconciliation {
  id                     String                   @id @default(uuid())
  clientId               String
  client                 Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bankAccountId          String
  bankAccount            ChartOfAccount           @relation(fields: [bankAccountId], references: [id])
  statementDate          DateTime
  statementEndingBalance Decimal
  status                 String @default("IN_PROGRESS")
  completedById          String?
  completedAt            DateTime?
  createdAt              DateTime                 @default(now())

  @@map("bank_reconciliations")
}

// ---------------------------------------------------------------------------
// Document Intelligence v1 (SRS 40) - regex field extraction from text-based
// PDFs. Image OCR (scanned documents) and real ML classification are not
// implemented - see docs/ARCHITECTURE.md.
// ---------------------------------------------------------------------------


model DocumentExtraction {
  id            String                   @id @default(uuid())
  documentId    String                   @unique
  document      Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status        String @default("PENDING")
  extractedText String?
  fields        String?
  confidence    Decimal?
  processedAt   DateTime?
  createdAt     DateTime                 @default(now())

  @@map("document_extractions")
}

// ---------------------------------------------------------------------------
// Phase 3 - Saudi compliance (docs/ARCHITECTURE.md roadmap)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Regulatory Rules Engine (SRS 58). Rates/thresholds are versioned data,
// never hard-coded in application code: RegulatoryRulesService resolves
// "the applicable rule for (jurisdiction, ruleType, code) as of a date" by
// querying this table, so a rate change (or a jurisdiction added later)
// never requires touching VAT/WHT/Zakat calculation code. Global, not
// client-scoped - "Saudi VAT is 15%" is a fact about the jurisdiction, not
// about any one firm's client.
// ---------------------------------------------------------------------------


model RegulatoryRule {
  id            String    @id @default(uuid())
  jurisdiction  String // ISO country code, e.g. "SA"
  authority     String // e.g. "ZATCA"
  ruleType      String
  code          String // e.g. "STANDARD", "ZERO_RATED" (VAT); "SERVICES", "ROYALTIES" (WHT)
  name          String
  description   String?
  rate          Decimal // percentage, e.g. 15.0000
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([jurisdiction, ruleType, code, effectiveFrom])
  @@map("regulatory_rules")
}

// ---------------------------------------------------------------------------
// Tax periods (SRS 25-28) - a shared filing-window concept reused by VAT,
// WHT, and Zakat returns, and the source of their compliance-calendar
// deadlines.
// ---------------------------------------------------------------------------


model TaxPeriod {
  id         String        @id @default(uuid())
  clientId   String
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodType String
  name       String
  startDate  DateTime
  endDate    DateTime
  dueDate    DateTime
  createdAt  DateTime      @default(now())

  vatReturns   VatReturn[]
  whtReturns   WhtReturn[]
  zakatReturns ZakatReturn[]

  @@unique([clientId, periodType, name])
  @@map("tax_periods")
}

// ---------------------------------------------------------------------------
// VAT Returns (SRS 25-26)
// ---------------------------------------------------------------------------


model VatReturn {
  id               String          @id @default(uuid())
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taxPeriodId      String
  taxPeriod        TaxPeriod       @relation(fields: [taxPeriodId], references: [id], onDelete: Cascade)
  outputVat        Decimal         @default(0)
  inputVat         Decimal         @default(0)
  netVatDue        Decimal         @default(0) // positive = payable, negative = refundable
  status           String @default("DRAFT")
  payableAccountId String?
  payableAccount   ChartOfAccount? @relation("VatReturnPayableAccount", fields: [payableAccountId], references: [id])
  journalId        String?         @unique
  journal          Journal?        @relation(fields: [journalId], references: [id])
  filedById        String?
  filedAt          DateTime?
  createdAt        DateTime        @default(now())

  @@unique([taxPeriodId])
  @@map("vat_returns")
}

// ---------------------------------------------------------------------------
// Withholding Tax Returns (SRS 28). WHT itself is withheld and accrued at
// each Payment (see Payment.whtAmount) - a WhtReturn is a period summary of
// those accruals for filing/record-keeping, not a separate posting (the GL
// impact already happened when each payment was posted). Remitting the
// accumulated WHT Payable balance to the authority is an ordinary manual
// journal entry via the existing Journals module.
// ---------------------------------------------------------------------------

model WhtReturn {
  id          String          @id @default(uuid())
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taxPeriodId String
  taxPeriod   TaxPeriod       @relation(fields: [taxPeriodId], references: [id], onDelete: Cascade)
  totalWht    Decimal         @default(0)
  breakdown   String // JSON: [{ categoryCode, categoryName, amount }]
  status      String @default("DRAFT")
  filedById   String?
  filedAt     DateTime?
  createdAt   DateTime        @default(now())

  @@unique([taxPeriodId])
  @@map("wht_returns")
}

// ---------------------------------------------------------------------------
// Zakat Engine (SRS 27). zakatBase follows the commonly-published
// "net worth" method as a configurable starting point, not vetted tax
// advice - see ZakatService and docs/ARCHITECTURE.md:
//   zakatBase = equity + additions - netFixedAssets - deductions
//   zakatDue  = max(zakatBase, 0) * zakatRate
// ---------------------------------------------------------------------------

model ZakatReturn {
  id                   String          @id @default(uuid())
  clientId             String
  client               Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taxPeriodId          String
  taxPeriod            TaxPeriod       @relation(fields: [taxPeriodId], references: [id], onDelete: Cascade)
  equityAmount         Decimal         @default(0)
  netFixedAssetsAmount Decimal         @default(0)
  additionsTotal       Decimal         @default(0)
  deductionsTotal      Decimal         @default(0)
  zakatBase            Decimal         @default(0)
  zakatRate            Decimal         @default(0)
  zakatDue             Decimal         @default(0)
  status               String @default("DRAFT")
  expenseAccountId     String?
  expenseAccount       ChartOfAccount? @relation("ZakatReturnExpenseAccount", fields: [expenseAccountId], references: [id])
  payableAccountId     String?
  payableAccount       ChartOfAccount? @relation("ZakatReturnPayableAccount", fields: [payableAccountId], references: [id])
  journalId            String?         @unique
  journal              Journal?        @relation(fields: [journalId], references: [id])
  filedById            String?
  filedAt              DateTime?
  createdAt            DateTime        @default(now())

  adjustments ZakatAdjustment[]

  @@unique([taxPeriodId])
  @@map("zakat_returns")
}


model ZakatAdjustment {
  id            String              @id @default(uuid())
  zakatReturnId String
  zakatReturn   ZakatReturn         @relation(fields: [zakatReturnId], references: [id], onDelete: Cascade)
  description   String
  type          String
  amount        Decimal
  createdAt     DateTime            @default(now())

  @@map("zakat_adjustments")
}

// ---------------------------------------------------------------------------
// ZATCA-shaped e-invoicing v1 (SRS 26) - local generation only, see
// EInvoiceService: a TLV/base64 QR payload (the published "Phase 1"
// simplified-invoice QR fields) and an illustrative UBL-shaped XML. Neither
// is submitted to ZATCA's live Fatoora platform or cryptographically
// stamped - this environment has no government-issued certificate to do
// that with. docs/ARCHITECTURE.md spells this out.
// ---------------------------------------------------------------------------

model EInvoiceRecord {
  id              String   @id @default(uuid())
  invoiceId       String   @unique
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  qrPayloadBase64 String
  xmlContent      String
  generatedAt     DateTime @default(now())

  @@map("einvoice_records")
}

// ---------------------------------------------------------------------------
// Compliance Calendar (SRS 47)
// ---------------------------------------------------------------------------


model ComplianceDeadline {
  id                String                   @id @default(uuid())
  clientId          String
  client            Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category          String // e.g. "VAT_RETURN", "WHT_RETURN", "ZAKAT_RETURN", "CUSTOM"
  title             String
  dueDate           DateTime
  status            String @default("PENDING")
  relatedEntityType String?
  relatedEntityId   String?
  notes             String?
  completedById     String?
  completedAt       DateTime?
  createdAt         DateTime                 @default(now())

  @@map("compliance_deadlines")
}

// ---------------------------------------------------------------------------
// AI Workforce (SRS 37-39, 66-68) - Phase 5's MVP subset of the 20-agent
// roster (SRS 98 Phase 5): Accounting, Tax, Audit, Reconciliation,
// Reporting, Document, Compliance, Financial Analyst. Every finding an
// agent produces is one AiAgentRun row - the OBSERVE...RECORD EVIDENCE
// pipeline (SRS 38) made durable: `observation`/`reasoning` cite the real
// source records the finding was computed from (SRS 67's "cite source
// records, show calculations, avoid fabricated information"), and
// `confidence`/`dataCompleteness`/`ruleCertainty` are SRS 39's per-
// recommendation transparency fields. No agent here ever writes to the
// ledger or any other domain table - `recommendedAction` tops out at
// ESCALATE_TO_REVIEW/AUTO_POST_PERMITTED as a *label*, not an executed
// action (SRS 4: AI never has final authority over a posting or
// professional conclusion) - so `humanReviewRequired` is always true in
// this build. `reviewSeverity` is SRS 68's Professional Review Queue
// color coding.
// ---------------------------------------------------------------------------



// Mirrors SRS 68's Professional Review Queue emoji tiers, in the order
// they're commonly listed there (not a severity ranking):
// PROFESSIONAL_JUDGMENT=red, CA_REVIEW=orange, ACCOUNTANT_REVIEW=yellow,
// CLIENT_CLARIFICATION=blue, AUTO_VALIDATED=green.



model AiAgentRun {
  id         String      @id @default(uuid())
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentType  String
  // Polymorphic pointer to the record the finding is about (a Journal, a
  // Supplier, an AuditFinding, ...) - deliberately not a typed FK since it
  // varies by agent; entityId is null for a client-wide finding with no
  // single source row (e.g. an out-of-balance trial balance).
  entityType String?
  entityId   String?

  title            String
  // What raw data the agent looked at (SRS 38 OBSERVE).
  observation      String
  // What was computed/concluded and why, citing the actual records above
  // (SRS 38 UNDERSTAND/RETRIEVE/CALCULATE; SRS 67 "show calculations").
  reasoning        String
  confidence       Int // 0-100
  dataCompleteness Int // 0-100
  evidenceQuality  String
  ruleCertainty    String // e.g. "Deterministic threshold" vs "Heuristic pattern match"
  risk             String
  materiality      Decimal?

  recommendedAction   String
  reviewSeverity      String
  humanReviewRequired Boolean             @default(true)

  status         String       @default("OPEN")
  reviewedById   String?
  reviewedBy     User?             @relation("AiAgentRunReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewDecision String?
  reviewNotes    String?

  createdAt DateTime @default(now())

  @@index([clientId, status])
  @@index([clientId, agentType])
  @@map("ai_agent_runs")
}
